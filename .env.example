# Required in production: signs the anonymous free-usage counter so users cannot
# simply edit the 10-search limit in browser storage. Generate a long random value.
USAGE_SIGNING_SECRET=

# Required in production after the first 3 free searches. Create a Cloudflare
# Turnstile widget for the BizNameLens hostname and add its public site key and
# private secret key here. Local development automatically uses Cloudflare's
# official always-pass test keys when these are unset.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: enables automated Virginia LLC/corporation matching using
# opendata.best datasets sourced from Virginia SCC open data.
OPENDATA_API_KEY=

# Optional override for USPTO Trademark Search runtime configuration.
# Leave unset in normal deployments.
TMSEARCH_CONFIG_URL=https://tmsearch.uspto.gov/configuration.json
